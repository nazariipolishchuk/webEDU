{
  "name": "drannotation-web-lab6",
  "version": "1.0.0",
  "description": "DrAnnotation dataset catalogue of lab 5 ported to TypeScript",
  "author": "Nazar Polishchuk <polishuknazar37@gmail.com>",
  "license": "ISC",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "browserslist": [
    "defaults"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:dev": "tsc -b && vite build --mode development",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "typecheck:watch": "tsc -b --noEmit --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "sass": "^1.108.0",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6"
  }
}
