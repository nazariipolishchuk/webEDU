{
  "printWidth": 100,
  "singleQuote": false,
  "semi": true,
  "trailingComma": "all",
  "tabWidth": 2,
  "overrides": [
    {
      "files": ["*.config.js", "*.config.ts"],
      "options": { "singleQuote": true }
    },
    {
      "files": "*.html",
      "options": { "tabWidth": 4, "printWidth": 120 }
    }
  ]
}
